<ItemGroup><Resource Include="Assets/AffixPrism.ico" /><Resource Include="Assets/AffixPrism-tray.ico" /></ItemGroup>
<ItemGroup><Resource Include="Assets/AffixPrism.png" /></ItemGroup>
