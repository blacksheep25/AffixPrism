       </ListBox>
       <StackPanel x:Name="EmptyWatch" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="Build your Expedition shortlist" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Add rewards you want to look out for. Enter your own reference values, or leave the price blank." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
      </Grid>
      <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="Reward name" Margin="0,0,0,4"/><TextBox x:Name="RewardName" MaxLength="120" AutomationProperties.Name="Reward name"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Unit price (optional)" FontSize="11" Foreground="{StaticResource Muted}"/><TextBox x:Name="RewardPrice" MaxLength="20" AutomationProperties.Name="Unit price"/></StackPanel><Button Grid.Column="1" Content="Save item" Click="SaveReward" VerticalAlignment="Bottom" Margin="8,0"/><Button x:Name="RemoveButton" Grid.Column="2" Content="Remove" IsEnabled="False" Click="RemoveReward" VerticalAlignment="Bottom"/></Grid></StackPanel>
     </Grid>
    </Grid></Expander></StackPanel></ScrollViewer></Border></Grid></TabItem>
    <TabItem Visibility="Collapsed" x:Name="ComparisonTab" ><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⇄" Width="25" FontSize="17"/><TextBlock Text="Compare" VerticalAlignment="Center" FontSize="12"/></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,18,0,16"><TextBlock Text="Item comparison" FontFamily="Georgia" FontSize="20" Foreground="{StaticResource Theme.Text}"/><TextBlock Text="Review your current item alongside your pinned reference." Foreground="{StaticResource Theme.Muted}" Margin="0,8,0,0"/></StackPanel><Border Grid.Row="1" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Divider}" BorderThickness="1" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Pin an item from Item check, then inspect another. Compare exact properties and modifiers side by side." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid Margin="0,0,8,0"><TextBox x:Name="ComparisonLeft" Text="No pinned item" Visibility="Collapsed"/><ScrollViewer VerticalScrollBarVisibility="Auto"><local:ItemPreviewCard x:Name="MainComparisonLeft"/></ScrollViewer></Grid><Grid Grid.Column="1" Margin="8,0,0,0"><TextBox x:Name="ComparisonRight" Text="No current item" Visibility="Collapsed"/><ScrollViewer VerticalScrollBarVisibility="Auto"><local:ItemPreviewCard x:Name="MainComparisonRight"/></ScrollViewer></Grid></Grid><Expander Foreground="{StaticResource Theme.Gold}" Grid.Row="2" Header="Numerical changes" IsExpanded="False"><TextBox x:Name="ComparisonChanges" MaxHeight="160" Text="Pin an item to compare its modifiers." IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></Expander></Grid></Border></Grid></TabItem>
<TabItem x:Name="PricesTab"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⚖" Width="25" FontSize="18"/><TextBlock Text="Market Prices" FontSize="12" VerticalAlignment="Center"/></StackPanel></TabItem.Header><Grid Margin="-24,0,-24,-20"><Grid.ColumnDefinitions><ColumnDefinition Width="138"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Divider}" BorderThickness="0,0,1,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="10,12,6,4"><TextBlock Text="PERSONAL" FontSize="9" Foreground="{StaticResource Theme.Violet}" Margin="0,0,0,8"/><CheckBox x:Name="OnlyFavourites" Content="Favourites" Click="FilterFavourites" Foreground="{StaticResource Theme.Muted}" Margin="0,5,0,14"/><TextBlock Text="GENERAL" FontSize="9" Foreground="{StaticResource Theme.Violet}"/></StackPanel><ListBox x:Name="PriceCategory" SelectionChanged="PriceCategoryChanged" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Theme.Muted}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CategoryRow" Padding="12,9" BorderBrush="Transparent" BorderThickness="0,0,2,0" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CategoryRow" Property="Background" Value="{StaticResource Theme.Control}"/><Setter TargetName="CategoryRow" Property="BorderBrush" Value="{StaticResource Theme.Gold}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryRow" Property="Background" Value="{StaticResource Theme.Hover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border>
<Grid Grid.Column="1" Margin="22,20,22,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="MarketCategoryTitle" Text="Currency" FontFamily="Georgia" FontSize="20" Foreground="{StaticResource Theme.Text}"/><TextBlock x:Name="MarketFeedStatus" Text="Choose your league in Settings" FontSize="10" Foreground="{StaticResource Theme.Muted}" Margin="0,5,0,14"/></StackPanel><Button Grid.Column="1" x:Name="RefreshMarketButton" Content="↻" Click="RefreshMarketClick" ToolTip="Refresh prices" VerticalAlignment="Top" Padding="8,4"/></Grid>
<Grid Grid.Row="1" Margin="0,0,0,16"><TextBox x:Name="PriceSearch" TextChanged="PriceSearchChanged" AutomationProperties.Name="Search market items" Padding="30,7,10,7"/><TextBlock Text="⌕" Foreground="{StaticResource Theme.Muted}" FontSize="20" Margin="9,2" IsHitTestVisible="False"/><TextBlock Text="Search items…" Foreground="{StaticResource Theme.Muted}" Margin="31,9,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PriceSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
