<Grid Grid.Row="3"><TextBlock x:Name="MarketEmptyState" Text="Loading market data…" Foreground="#928D75" Margin="8,25" TextWrapping="Wrap" VerticalAlignment="Top"/><ListBox ItemTemplate="{StaticResource MarketItemRow}" x:Name="MarketPriceRows" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Theme.Text}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></Grid>
</Grid></Grid></TabItem>
    <TabItem x:Name="MarketTab" ><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="↗" Width="25" FontSize="17"/><TextBlock Text="Trade Research" VerticalAlignment="Center" FontSize="12"/></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,18,0,16"><TextBlock Text="Market research" FontFamily="Georgia" FontSize="20" Foreground="{StaticResource Theme.Text}"/><TextBlock Text="Explore asking prices and evaluate your next trade." Foreground="{StaticResource Theme.Muted}" Margin="0,8,0,0"/></StackPanel><Border Grid.Row="1" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Divider}" BorderThickness="1" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Research your checked item" FontSize="22" Foreground="{StaticResource Theme.Gold}"/><WrapPanel Margin="0,10"><Button Content="Return to item comparison" Click="ReturnToComparison"/><Button Content="Choose a bookmarked item" Click="OpenSavedEquipment" Margin="8,0"/></WrapPanel>
<TextBlock Text="1. Inspect an item with Alt+E for comparable offers.  2. Enter your buy price and expected sale below.  3. Review the net result before deciding." TextWrapping="Wrap" Margin="0,8"/>
<Expander Foreground="{StaticResource Theme.Gold}" Header="Comparable listing opportunities · from your last item check" IsExpanded="True"><TextBlock x:Name="ResaleCandidates" Text="Price-check equipment to compare cheaper offers with similar-listing medians." TextWrapping="Wrap" Margin="0,8"/></Expander>
<Expander Foreground="{StaticResource Theme.Gold}" Header="Corruption price research · availability varies by category" IsExpanded="False"><StackPanel><ComboBox x:Name="OpportunityCategory" SelectedIndex="0" Margin="0,8"><ComboBoxItem Content="Unique armour" Tag="UniqueArmours"/><ComboBoxItem Content="Unique weapons" Tag="UniqueWeapons"/><ComboBoxItem Content="Unique accessories" Tag="UniqueAccessories"/><ComboBoxItem Content="Unique jewels" Tag="UniqueJewels"/></ComboBox><WrapPanel><Button Content="Check available comparisons" Click="LoadOpportunities" Margin="0,0,8,0"/><Button Content="Browse category prices" Click="BrowseResearchCategory"/></WrapPanel><TextBlock x:Name="OpportunityStatus" TextWrapping="Wrap" Margin="0,8"/><ItemsControl x:Name="OpportunityRows"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="A premium is not expected profit. Outcomes, rolls, demand and sale time differ. No success probabilities are assumed." TextWrapping="Wrap" Margin="0,8"/></StackPanel></Expander>
<Expander Foreground="{StaticResource Theme.Gold}" Header="Profit calculator" IsExpanded="True"><StackPanel>
<TextBlock Text="Use the same currency for every amount" Foreground="{StaticResource Theme.Muted}" Margin="0,0,0,6"/><ComboBox x:Name="PlanCurrency" SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="Exalted Orb"/><ComboBoxItem Content="Divine Orb"/><ComboBoxItem Content="Chaos Orb"/></ComboBox><TextBlock Text="Buy price"/><TextBox x:Name="PlanBuy" Text="0"/><TextBlock Text="Crafting / corruption cost"/><TextBox x:Name="PlanCost" Text="0"/><TextBlock Text="Target sale price"/><TextBox x:Name="PlanSale" Text="0"/><TextBlock Text="Chance of selling at the target (%) · use 100 for an ordinary resale"/><TextBox x:Name="PlanChance" Text="100"/><TextBlock Text="Average sale value of all other outcomes (0 if destroyed)"/><TextBox x:Name="PlanFailure" Text="0"/><Button Content="Calculate" Click="CalculateOpportunity" Margin="0,8"/><TextBlock x:Name="PlanResult" TextWrapping="Wrap"/>
</StackPanel></Expander></StackPanel></ScrollViewer></Border></Grid></TabItem>
    <TabItem x:Name="GuidesTab"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Width="25" FontSize="17"/><TextBlock Text="Encounters" FontSize="12" VerticalAlignment="Center"/></StackPanel></TabItem.Header><Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Encounter rewards" FontFamily="Georgia" FontSize="20" Foreground="{StaticResource Theme.Text}"/><TextBlock Text="Choose an encounter to browse its reward prices. Use Rune Helper in the sidebar for on-screen rune choices." Margin="0,8,0,18" Foreground="{StaticResource Theme.Muted}"/></StackPanel><DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="Refresh rewards" Click="LoadGuide" Margin="8,0,0,0"/><ComboBox x:Name="GuideKind" SelectedIndex="0" SelectionChanged="GuideCategoryChanged"><ComboBoxItem Content="Expedition"/><ComboBoxItem Content="Delirium"/><ComboBoxItem Content="Ritual"/></ComboBox></DockPanel><TextBlock x:Name="GuideStatus" Grid.Row="2" Margin="0,12" Foreground="{StaticResource Theme.Muted}"/><ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="GuideRows"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Theme.Surface}" Padding="12" Margin="0,2"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><local:RemoteItemIcon Url="{Binding IconUrl}" Width="28" Height="28"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding PriceLabel}" Foreground="{StaticResource Theme.Gold}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></TabItem>
<TabItem x:Name="RuneTab"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="◇" Width="25" FontSize="17"/><TextBlock Text="Rune Helper" FontSize="12" VerticalAlignment="Center"/></StackPanel></TabItem.Header><ContentControl x:Name="RuneHost" Margin="0,16,0,0"/></TabItem>
    <TabItem x:Name="SessionTab" ><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="25" FontSize="17"/><TextBlock Text="Session" VerticalAlignment="Center" FontSize="12"/></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,18,0,16"><TextBlock Text="Your session" FontFamily="Georgia" FontSize="20" Foreground="{StaticResource Theme.Text}"/><TextBlock Text="Area history and the loot you choose to record." Foreground="{StaticResource Theme.Muted}" Margin="0,8,0,0"/></StackPanel><Border Grid.Row="1" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Divider}" BorderThickness="1" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="{StaticResource Theme.Surface}" BorderBrush="#373427" BorderThickness="1" Padding="18"><StackPanel><TextBlock Text="SESSION OVERVIEW" Foreground="{StaticResource Theme.Gold}" FontSize="11" Margin="0,0,0,10"/><TextBlock x:Name="SessionStatus" FontSize="20"/><TextBlock Text="Area changes are automatic. Loot is counted only when you add it below. Session history and loot are saved locally." Foreground="{StaticResource Muted}" Margin="0,8,0,12"/><Button Content="Reset session" Click="ResetSession" HorizontalAlignment="Left"/></StackPanel></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="SessionLootPanel" BorderBrush="{StaticResource Theme.Divider}" BorderThickness="1" Padding="18" Margin="0,18,9,0"><StackPanel><TextBlock Text="Loot recorded" FontSize="17" Margin="0,18,0,8"/><TextBlock x:Name="SessionLootItem" Text="Price-check an item first." TextWrapping="Wrap" Margin="0,0,0,6"/><Button x:Name="RecordSessionLoot" Content="Add one current item to loot" Click="TrackLoot" IsEnabled="False" HorizontalAlignment="Left"/><TextBlock x:Name="LootActionStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"/><ItemsControl x:Name="LootRows" ><ItemsControl.ItemTemplate><DataTemplate><Border Grid.Column="1" BorderBrush="{StaticResource Theme.Divider}" BorderThickness="0,0,0,1" Padding="4,12"><TextBlock Text="{Binding Label}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border x:Name="SessionAreaPanel" Grid.Column="1" BorderBrush="{StaticResource Theme.Divider}" BorderThickness="1" Padding="18" Margin="9,18,0,0"><StackPanel><TextBlock Text="Area history" FontSize="17" Margin="0,18,0,8"/><ItemsControl x:Name="AreaRows" ><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Theme.Divider}" BorderThickness="0,0,0,1" Padding="4,12"><TextBlock Text="{Binding Label}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid></StackPanel></ScrollViewer></Border></Grid></TabItem>
    <TabItem Visibility="Collapsed" x:Name="SettingsTab" ><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="25" FontSize="17"/><TextBlock Text="Settings" VerticalAlignment="Center" FontSize="12"/></StackPanel></TabItem.Header><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,18,0,16"><TextBlock Text="Preferences" FontFamily="Georgia" FontSize="20" Foreground="{StaticResource Theme.Text}"/><TextBlock Text="Make AffixPrism fit the way you play." Foreground="{StaticResource Theme.Muted}" Margin="0,8,0,0"/></StackPanel><Border Grid.Row="1" Background="{StaticResource Theme.Surface}" BorderBrush="{StaticResource Theme.Divider}" BorderThickness="1" Padding="20">
     <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel>
      <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <TextBlock Text="Item-check shortcut"/><TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="CaptureHotkey" AutomationProperties.Name="Item-check shortcut" Margin="0,5,0,5"/><TextBlock Text="Click above and press Alt, Ctrl or Shift plus a letter, number or function key. Save to apply." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/><TextBlock Text="Game log"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseLog" Margin="6,0,0,0"/><TextBox x:Name="LogPathBox" AutomationProperties.Name="Game log path"/></DockPanel>
      <TextBlock Text="League"/><Grid Margin="0,5,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="LeagueBox" IsEditable="False" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="League"/><Button x:Name="RefreshLeaguesButton" Grid.Column="1" Content="Refresh" Click="RefreshLeaguesClick" Margin="6,0,0,0"/></Grid><TextBlock x:Name="LeagueStatus" Text="Choose your league, then Save settings." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
<Expander Header="Item metadata colours" Foreground="{StaticResource Theme.Gold}" IsExpanded="False" Margin="0,6,0,12"><StackPanel><TextBlock Text="Colour identifies the source or state, not its value. Unusual and legacy types use explicit overlay colours." TextWrapping="Wrap"/><ItemsControl x:Name="MetadataLegend"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Name}" Foreground="{Binding Colour}" FontWeight="SemiBold"/><TextBlock Text="{Binding UseCase}" Foreground="#B4B1A5" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
      <TextBlock Text="Currency for your reference prices"/><ComboBox x:Name="CurrencyBox" IsEditable="False" Margin="0,5,0,12" AutomationProperties.Name="Reference currency"/>
      <TextBlock Text="Changing league or currency clears reference prices." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
      <CheckBox x:Name="AutoCheck" Content="Show separate guide in Logbook areas" Margin="0,0,0,14"/>
      <DockPanel><TextBlock Text="Overlay opacity"/><TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{StaticResource Theme.Gold}"/></DockPanel><Slider x:Name="OpacitySlider" Minimum="0.55" Maximum="1" ValueChanged="OpacityChanged" Margin="0,7,0,14" AutomationProperties.Name="Overlay opacity"/><TextBlock Text="Applies immediately to all overlay windows and saves automatically." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/>

      <TextBlock Text="Shortcuts" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock x:Name="ShortcutSummary" Text="Alt+E   Check hovered item&#10;Ctrl+Alt+O   Show / hide overlay&#10;Ctrl+Alt+L   Toggle click-through" Foreground="{StaticResource Muted}"/>
      <Button Content="Toggle click-through" Click="ToggleLockClick" Margin="0,12,0,0" HorizontalAlignment="Left"/>
      <TextBlock Text="Click-through lets mouse input reach the game. Use Ctrl+Alt+L or the tray menu to unlock." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
      <TextBlock Text="Reads area transitions locally. Your item-check shortcut sends one Ctrl+C action to POE2, then reads the freshly copied item. No repeated copy attempts are sent." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
      <TextBlock Text="This product isn't affiliated with or endorsed by Grinding Gear Games in any way." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
     </StackPanel></ScrollViewer><Border Grid.Row="1" BorderBrush="{StaticResource Theme.Selected}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"><Button Content="Save settings" Click="SaveSettings" HorizontalAlignment="Right" MinWidth="130"/></Border></Grid>
    </Border></Grid></TabItem>
   </TabControl>
   <TextBlock x:Name="Notice" Grid.Row="3" Text="Ctrl+Alt+O to show or hide" Foreground="{StaticResource Muted}" FontSize="11" Margin="20,10,20,10"/>
  </Grid>
 </Border>
