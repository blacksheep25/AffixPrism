<Window Icon="/AffixPrism;component/Assets/AffixPrism.ico" x:Class="AffixPrism.ExpeditionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AffixPrism · Expedition" Width="350" Height="350" MinWidth="300" MinHeight="240" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Theme.Text}">
 <Border Background="#15191E" BorderBrush="{StaticResource Theme.Border}" BorderThickness="1" CornerRadius="8" Padding="16"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Expedition" FontSize="19" FontWeight="SemiBold"/><Thumb Cursor="SizeAll" DragDelta="DragPanel" AutomationProperties.Name="Move Expedition guide"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template></Thumb><Button Grid.Column="1" Content="Hide" Click="HideGuide"/></Grid>
  <StackPanel Grid.Row="1" Margin="0,12,0,12"><TextBlock x:Name="ZoneText" Foreground="{StaticResource Theme.Text}"/><TextBlock x:Name="MarketText" Foreground="{StaticResource Theme.Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
  <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Rewards"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="0,9" BorderBrush="{StaticResource Theme.Border}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding DateLabel}" Foreground="{StaticResource Theme.Muted}" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ValueLabel}" HorizontalAlignment="Right" Foreground="{StaticResource Theme.Text}" FontSize="17"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="EmptyText" Text="Add rewards in the Shortlist tab to build your shortlist." Foreground="{StaticResource Theme.Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
  <TextBlock Grid.Row="3" x:Name="PriceSource" Text="Manual reference prices" Foreground="{StaticResource Theme.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid></Border>
</Window>
