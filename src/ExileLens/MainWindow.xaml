<Window Icon="/ExileLens;component/Assets/ExileLens.ico" x:Class="ExileLens.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Exile Lens" Width="720" Height="760" MinWidth="600" MinHeight="560" WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent" Topmost="True" FontFamily="Segoe UI" FontSize="13" Foreground="#D9D2BC">
 <Window.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Background" Value="#181814"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#59523E" CornerRadius="2" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="9"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#1C1C18"/><Setter Property="Foreground" Value="#D9D2BC"/><Setter Property="BorderBrush" Value="#554D38"/></Style>
  <SolidColorBrush x:Key="Muted" Color="#B9B09A"/>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#D9D2BC"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="#1C1C18" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#3A3729"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#494332"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#D9D2BC"/><Setter Property="Background" Value="#1C1C18"/><Setter Property="MinHeight" Value="34"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="#1C1C18" BorderBrush="#554D38" BorderThickness="1" Padding="8"><Grid><ContentPresenter/><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#B9B09A" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#BFA56D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Margin="8,6,26,6" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" VerticalAlignment="Center"/>
   <TextBlock Text="Select…" Foreground="#B9B09A" Margin="8,6,26,6" IsHitTestVisible="False" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#1C1C18" BorderBrush="#554D38" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="250"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
  </Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#26251E"/><Setter Property="Foreground" Value="#D9D2BC"/><Setter Property="BorderBrush" Value="#554D38"/><Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#3A3729"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#BFA56D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#1C1C18"/><Setter Property="Foreground" Value="#D9D2BC"/><Setter Property="CaretBrush" Value="#BFA56D"/><Setter Property="BorderBrush" Value="#554D38"/><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#726047"/></Style>
  <Style TargetType="Slider"><Setter Property="MinHeight" Value="28"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent"><Border Height="3" Background="#494332" VerticalAlignment="Center"/><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#BFA56D" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#BFA56D" BorderBrush="#DDD0A2" BorderThickness="1" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#302E24"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D9D2BC"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#B9B09A"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Padding="12,10" BorderThickness="0,0,0,2" BorderBrush="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#BFA56D"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#BFA56D"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#26251E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Background="#11110F" BorderBrush="#494332" BorderThickness="1" CornerRadius="0" Padding="20,14,20,16">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Background="Transparent" Margin="0,0,0,14">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Exile Lens" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="LockState" Text="POE2 companion" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
    <Thumb x:Name="TitleDragHandle" Cursor="SizeAll" DragDelta="DragHeaderDelta" DragCompleted="DragHeaderCompleted" ToolTip="Drag to move the overlay" AutomationProperties.Name="Move overlay">
     <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
    </Thumb>
    <Button Grid.Column="1" Content="Hide" Click="HideClick" ToolTip="Hide · Ctrl+Alt+O to reopen" Margin="8,0" VerticalAlignment="Center"/>
    <Button Grid.Column="2" Content="Exit" Click="ExitClick" VerticalAlignment="Center"/>
   </Grid>
   <Border Grid.Row="1" BorderBrush="#494332" BorderThickness="0,1,0,1" Padding="0,11" Margin="0,0,0,8"><StackPanel><TextBlock x:Name="AreaLabel" Text="Waiting for your next area" FontWeight="SemiBold"/><TextBlock x:Name="LogStatus" Text="Connecting to game log…" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border>
   <TabControl SelectionChanged="TabChanged" x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,16,0,0">
    <TabItem x:Name="ItemTab" Header="Item check">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="CheckInstructions" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
      <TextBlock x:Name="ItemName" Text="Hover an item. Press Alt+E." FontSize="22" Foreground="#BFA56D"/>
      <TextBlock x:Name="ItemMeta" Text="Your next item check appears here" Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBox x:Name="ItemDetails" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" Height="210" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0"/>
       <StackPanel Grid.Column="1"><TextBlock Text="Evaluation" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="QuoteStatus" Text="Currency and unique estimates from poe.ninja. Rare items need comparable listings." Foreground="{StaticResource Muted}" Margin="0,6,0,8"/><ItemsControl x:Name="Quotes"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding PriceLabel}" FontSize="19" Foreground="#BFA56D"/><TextBlock Text="{Binding DetailLabel}" FontSize="11" Foreground="#B9B09A"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      </Grid>
      <TextBlock x:Name="SearchStatus" Text="Check an item to begin." Margin="0,12,0,8" Foreground="{StaticResource Muted}"/>
      <WrapPanel><Button Content="Use copied item" Click="ReadClipboardClick" Margin="0,0,6,6"/><Button Content="Refresh estimate" Click="RefreshEstimate" Margin="0,0,6,6"/><Button Content="Pin comparison" Click="PinComparison" Margin="0,0,6,6"/></WrapPanel>
      <Expander Header="Trade filters" IsExpanded="True" Foreground="#D9D2BC" Margin="0,8,0,12"><StackPanel Margin="0,8,0,0">
       <TextBlock Text="Base type"/><TextBox x:Name="FilterBase"/>
       <WrapPanel Margin="0,8,0,8"><StackPanel Width="110" Margin="0,0,10,0"><TextBlock Text="Min. item level"/><TextBox x:Name="FilterLevel"/></StackPanel><StackPanel Width="110" Margin="0,0,10,0"><TextBlock Text="Min. quality"/><TextBox x:Name="FilterQuality"/></StackPanel><CheckBox x:Name="FilterRarity" Content="Match rarity" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox x:Name="FilterCorrupted" Content="Corrupted" IsThreeState="True" IsChecked="{x:Null}" VerticalAlignment="Center" ToolTip="Indeterminate: either; checked: corrupted; unchecked: uncorrupted"/></WrapPanel>
       <Button x:Name="SearchButton" Content="Open comparable listings" IsEnabled="False" Click="OpenTrade" HorizontalAlignment="Left"/>
      </StackPanel></Expander>
      <TextBlock Text="Recent checks · this session" Foreground="{StaticResource Muted}"/><ComboBox x:Name="RecentItems" DisplayMemberPath="Label" SelectionChanged="SelectRecent" Margin="0,5,0,0"/>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem x:Name="ExpeditionTab" Header="Shortlist">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Worth watching" FontSize="22" FontWeight="SemiBold"/><CheckBox x:Name="PinCheck" Grid.Column="1" Content="Keep open" VerticalAlignment="Center" Click="PinChanged"/></Grid>
      <StackPanel Grid.Row="1" Margin="0,7,0,16"><TextBlock x:Name="MarketLabel" Foreground="{StaticResource Muted}"/><TextBlock Text="Manual reference prices · live pricing not connected" Foreground="#BFA56D" FontSize="12" Margin="0,5,0,0"/></StackPanel>
      <Grid Grid.Row="2">
       <ListBox x:Name="WatchList" Background="Transparent" BorderThickness="0" Foreground="#D9D2BC" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" SelectionChanged="WatchSelected">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#363225"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#29271E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#494332" BorderThickness="0,0,0,1" Padding="8,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding DateLabel}" Foreground="#B9B09A" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ValueLabel}" HorizontalAlignment="Right" FontSize="18" Foreground="#BFA56D"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <StackPanel x:Name="EmptyWatch" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="Build your Expedition shortlist" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Add rewards you want to look out for. Enter your own reference values, or leave the price blank." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
      </Grid>
      <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="Reward name" Margin="0,0,0,4"/><TextBox x:Name="RewardName" MaxLength="120" AutomationProperties.Name="Reward name"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Unit price (optional)" FontSize="11" Foreground="{StaticResource Muted}"/><TextBox x:Name="RewardPrice" MaxLength="20" AutomationProperties.Name="Unit price"/></StackPanel><Button Grid.Column="1" Content="Save item" Click="SaveReward" VerticalAlignment="Bottom" Margin="8,0"/><Button x:Name="RemoveButton" Grid.Column="2" Content="Remove" IsEnabled="False" Click="RemoveReward" VerticalAlignment="Bottom"/></Grid></StackPanel>
     </Grid>
    </TabItem>
    <TabItem x:Name="ComparisonTab" Header="Compare"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Pin an item from Item check, then inspect another. Compare exact properties and modifiers side by side." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="ComparisonLeft" Text="No pinned item" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,6,0"/><TextBox x:Name="ComparisonRight" Text="No current item" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="6,0,0,0"/></Grid><Expander Foreground="#BFA56D" Grid.Row="2" Header="Numerical changes" IsExpanded="False"><TextBox x:Name="ComparisonChanges" MaxHeight="160" Text="Pin an item to compare its modifiers." IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></Expander></Grid></TabItem>
    <TabItem x:Name="MarketTab" Header="Market"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Market opportunities" FontSize="22" Foreground="#BFA56D"/>
<TextBlock Text="Research asking-price gaps and plan trades. All calculator amounts must use the same currency." TextWrapping="Wrap" Margin="0,8"/>
<Expander Foreground="#BFA56D" Header="Similar-item resale candidates" IsExpanded="True"><TextBlock x:Name="ResaleCandidates" Text="Price-check equipment to compare cheaper offers with similar-listing medians." TextWrapping="Wrap" Margin="0,8"/></Expander>
<Expander Foreground="#BFA56D" Header="Corruption premiums" IsExpanded="True"><StackPanel><ComboBox x:Name="OpportunityCategory" SelectedIndex="0" Margin="0,8"><ComboBoxItem Content="UniqueArmours"/><ComboBoxItem Content="UniqueWeapons"/><ComboBoxItem Content="UniqueAccessories"/><ComboBoxItem Content="UniqueJewels"/></ComboBox><Button Content="Load corruption premiums" Click="LoadOpportunities"/><TextBlock x:Name="OpportunityStatus" TextWrapping="Wrap" Margin="0,8"/><ItemsControl x:Name="OpportunityRows"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="A premium is not expected profit. Outcomes, rolls, demand and sale time differ. No success probabilities are assumed." TextWrapping="Wrap" Margin="0,8"/></StackPanel></Expander>
<Expander Foreground="#BFA56D" Header="Profit and corruption outcome calculator" IsExpanded="True"><StackPanel>
<TextBlock Text="Buy price"/><TextBox x:Name="PlanBuy" Text="0"/><TextBlock Text="Crafting / corruption cost"/><TextBox x:Name="PlanCost" Text="0"/><TextBlock Text="Target sale price"/><TextBox x:Name="PlanSale" Text="0"/><TextBlock Text="Target outcome probability (%) · enter your researched odds"/><TextBox x:Name="PlanChance" Text="100"/><TextBlock Text="Average sale value of all other outcomes (0 if destroyed)"/><TextBox x:Name="PlanFailure" Text="0"/><Button Content="Calculate" Click="CalculateOpportunity" Margin="0,8"/><TextBlock x:Name="PlanResult" TextWrapping="Wrap"/>
</StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="GuidesTab" Header="Guides"><StackPanel><Button Content="Rune choice helper · live prices" Click="OpenRuneHelper" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="Encounter market guide" FontSize="22"/><TextBlock Text="Browse reward estimates by encounter. Logbooks open your separate shortlist automatically; in-map Ritual and Delirium encounters require manual selection." Foreground="{StaticResource Muted}" Margin="0,8,0,14"/><ComboBox x:Name="GuideKind" SelectedIndex="0"><ComboBoxItem Content="Expedition"/><ComboBoxItem Content="Delirium"/><ComboBoxItem Content="Ritual"/></ComboBox><Button Content="Load reward prices" Click="LoadGuide" Margin="0,10,0,10" HorizontalAlignment="Left"/><TextBlock x:Name="GuideStatus" Text="Select your league in Settings before loading prices." Foreground="{StaticResource Muted}"/><ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="GuideRows"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,10,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding PriceLabel}" Foreground="#BFA56D" Margin="12,0,0,0"/><TextBlock Text="{Binding Name}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></TabItem>
    <TabItem x:Name="SessionTab" Header="Session"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="SessionStatus" FontSize="20"/><TextBlock Text="Area changes are automatic. Loot is counted only when you add it below. Session history and loot are saved locally." Foreground="{StaticResource Muted}" Margin="0,8,0,12"/><Button Content="Reset session" Click="ResetSession" HorizontalAlignment="Left"/><TextBlock Text="Loot recorded" FontSize="17" Margin="0,18,0,8"/><TextBlock x:Name="SessionLootItem" Text="Price-check an item first." TextWrapping="Wrap" Margin="0,0,0,6"/><Button x:Name="RecordSessionLoot" Content="Add one current item to loot" Click="TrackLoot" IsEnabled="False" HorizontalAlignment="Left"/><TextBlock x:Name="LootActionStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"/><ItemsControl x:Name="LootRows" DisplayMemberPath="Label"/><TextBlock Text="Area history" FontSize="17" Margin="0,18,0,8"/><ItemsControl x:Name="AreaRows" DisplayMemberPath="Label"/></StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="SettingsTab" Header="Settings">
     <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel>
      <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/>
      <TextBlock Text="Item-check shortcut"/><TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="CaptureHotkey" AutomationProperties.Name="Item-check shortcut" Margin="0,5,0,5"/><TextBlock Text="Click above and press Alt, Ctrl or Shift plus a letter, number or function key. Save to apply." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/><TextBlock Text="Game log"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseLog" Margin="6,0,0,0"/><TextBox x:Name="LogPathBox" AutomationProperties.Name="Game log path"/></DockPanel>
      <TextBlock Text="League"/><Grid Margin="0,5,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="LeagueBox" IsEditable="False" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="League"/><Button x:Name="RefreshLeaguesButton" Grid.Column="1" Content="Refresh" Click="RefreshLeaguesClick" Margin="6,0,0,0"/></Grid><TextBlock x:Name="LeagueStatus" Text="Choose your league, then Save settings." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
<Expander Header="Item metadata colours" Foreground="#BFA56D" IsExpanded="False" Margin="0,6,0,12"><StackPanel><TextBlock Text="Colour identifies the source or state, not its value. Unusual and legacy types use explicit overlay colours." TextWrapping="Wrap"/><ItemsControl x:Name="MetadataLegend"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Name}" Foreground="{Binding Colour}" FontWeight="SemiBold"/><TextBlock Text="{Binding UseCase}" Foreground="#B4B1A5" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
      <TextBlock Text="Currency for your reference prices"/><ComboBox x:Name="CurrencyBox" IsEditable="False" Margin="0,5,0,12" AutomationProperties.Name="Reference currency"/>
      <TextBlock Text="Changing league or currency clears reference prices." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
      <CheckBox x:Name="AutoCheck" Content="Show separate guide in Logbook areas" Margin="0,0,0,14"/>
      <DockPanel><TextBlock Text="Overlay opacity"/><TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="#BFA56D"/></DockPanel><Slider x:Name="OpacitySlider" Minimum="0.55" Maximum="1" ValueChanged="OpacityChanged" Margin="0,7,0,14" AutomationProperties.Name="Overlay opacity"/><TextBlock Text="Applies immediately to all overlay windows and saves automatically." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/>

      <TextBlock Text="Shortcuts" FontWeight="SemiBold" Margin="0,22,0,8"/><TextBlock x:Name="ShortcutSummary" Text="Alt+E   Check hovered item&#10;Ctrl+Alt+O   Show / hide overlay&#10;Ctrl+Alt+L   Toggle click-through" Foreground="{StaticResource Muted}"/>
      <Button Content="Toggle click-through" Click="ToggleLockClick" Margin="0,12,0,0" HorizontalAlignment="Left"/>
      <TextBlock Text="Click-through lets mouse input reach the game. Use Ctrl+Alt+L or the tray menu to unlock." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
      <TextBlock Text="Reads area transitions locally. Your item-check shortcut sends one Ctrl+C action to POE2, then reads the freshly copied item. No repeated copy attempts are sent." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
      <TextBlock Text="This product isn't affiliated with or endorsed by Grinding Gear Games in any way." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
     </StackPanel></ScrollViewer><Border Grid.Row="1" BorderBrush="#494332" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"><Button Content="Save settings" Click="SaveSettings" HorizontalAlignment="Right" MinWidth="130"/></Border></Grid>
    </TabItem>
   </TabControl>
   <TextBlock x:Name="Notice" Grid.Row="3" Text="Ctrl+Alt+O to show or hide" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
  </Grid>
 </Border>
</Window>
